# ============================================================
# ARZ Email Outreach — Nodemailer SMTP Configuration
# Copy this file to .env and fill in your credentials
# ============================================================

# For Gmail: use smtp.gmail.com, port 465 (secure=true) + Google App Password
# Create App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=abdelrazekwork72@gmail.com
SMTP_PASS=your_16_char_gmail_app_password

# Sender Identity
FROM_NAME=Abdelrazek Mahmoud — ARZ Studio
FROM_EMAIL=abdelrazekwork72@gmail.com
REPLY_TO=abdelrazekwork72@gmail.com

# Test recipient for `npm run campaign:test`
TEST_RECIPIENT=abdelrazekwork72@gmail.com

# Rate-limiting delay between live sends (milliseconds) to protect deliverability
SEND_DELAY_MS=3500
