{
  "name": "arz-email-templates",
  "version": "2.0.0",
  "private": true,
  "description": "Responsive React Email templates & Node.js + Nodemailer personalized outreach engine matching ARZ Portfolio & ARZ Packages.",
  "scripts": {
    "dev": "email dev --dir emails --port 3000",
    "build": "email export --dir emails --outDir dist",
    "typecheck": "tsc --noEmit",
    "campaign:preview": "tsx scripts/send-client-campaigns.ts --dry-run",
    "campaign:test": "tsx scripts/send-client-campaigns.ts --test",
    "campaign:send": "tsx scripts/send-client-campaigns.ts --send"
  },
  "dependencies": {
    "@react-email/components": "^0.0.34",
    "@react-email/render": "^1.0.5",
    "dotenv": "^16.4.7",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "react-email": "^3.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
